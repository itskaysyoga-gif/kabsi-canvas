-- Definer review (R-126, 8 Nov 2026): the reviewed allowlist of SECURITY DEFINER functions the browser roles may run.
-- Each line was read for its caller check (docs/progress/archive/2026-11-08-definer-review.md). Included by
-- definer_allowlist.sql (fails on any definer function anon or authenticated can run that is not here, in any app
-- schema) and rls_functions.sql (one non-member test per authenticated line). Not a test file: pg_prove runs *.sql only.
-- Adding a line needs a reason, a caller and a test that a member of another business is refused.
create temp table definer_allowlist (role text, sig text, reason text, caller text, primary key (role, sig));
grant select on definer_allowlist to authenticated, anon;
insert into definer_allowlist (role, sig, reason, caller) values
