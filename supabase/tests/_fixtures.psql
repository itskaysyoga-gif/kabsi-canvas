-- P0.1-09: the victim's organisation, its membership and google_connections rows come from the triggers on
-- locations and location_members above. subscriptions starts empty.
insert into public.subscriptions (organization_id, plan, state)
select organization_id, 'pro', 'active' from public.locations where id = '00000000-0000-4000-8000-0000000000c1';

-- Every row that exists now belongs to the victim side (rows seeded by migrations included: no persona may read
-- them either). Physical row ids are stable inside this transaction because nothing below updates them.
create table tests.victim_rows (tbl text primary key, ctids tid[] not null);
do $$
declare t text; arr tid[];
begin
  for t in select c.relname from pg_class c where c.relnamespace = 'public'::regnamespace and c.relkind in ('r', 'p') loop
    execute format('select coalesce(array_agg(ctid), ''{}'') from public.%I', t) into arr;
    insert into tests.victim_rows values (t, arr);
  end loop;
end $$;
grant select on tests.victim_rows to anon, authenticated;

-- Rows of the victim side that the current role can see. No privilege on the table counts as seeing nothing.
create function tests.visible_victim_rows(p_table text) returns bigint language plpgsql as $$
declare n bigint;
begin
  execute format('select count(*) from public.%I where ctid = any ($1)', p_table)
    into n using (select ctids from tests.victim_rows where tbl = p_table);
  return n;
exception when insufficient_privilege then
  return 0;
end $$;
grant execute on function tests.visible_victim_rows(text) to anon, authenticated;

