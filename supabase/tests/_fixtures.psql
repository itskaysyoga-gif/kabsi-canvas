-- Shared fixtures for the database suite (P0.1-07). Included with \ir by each test file, inside its transaction, so
-- everything here is rolled back. Not a test file: pg_prove runs *.sql only.
--
-- The victim: owner A of business LA, and one row in every table that signed-in users can read. The personas: anon,
-- stranger S (no memberships), owner B of business LB, and two more signed-in users with no memberships, PA and QA
-- (until P0.8-01 they were members of the retired partner organisations P and Q; K-127).
-- A new table that anon or authenticated can read needs a victim row here, or rls_tables.sql fails.
--
-- Fixed ids (all invented):
--   users     A ..a1, PA ..a2, staff X ..a3, S ..b1, B ..b2, QA ..b3
--   LA ..c1, LB ..c2, review ..e1, other victim rows ..f*

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

insert into auth.users (instance_id, id, aud, role, email, email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
select '00000000-0000-0000-0000-000000000000', u.id, 'authenticated', 'authenticated', u.email, now(), '{}', '{}', now(), now()
from (values
  ('00000000-0000-4000-8000-0000000000a1'::uuid, 'victim-owner@example.test'),
  ('00000000-0000-4000-8000-0000000000a2'::uuid, 'victim-partner@example.test'),
  ('00000000-0000-4000-8000-0000000000a3'::uuid, 'victim-staff@example.test'),
  ('00000000-0000-4000-8000-0000000000b1'::uuid, 'stranger@example.test'),
  ('00000000-0000-4000-8000-0000000000b2'::uuid, 'other-owner@example.test'),
  ('00000000-0000-4000-8000-0000000000b3'::uuid, 'other-partner@example.test')
) as u(id, email);

