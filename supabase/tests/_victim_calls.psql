-- Kabsi staff read every business for support and installers activate cards (is_staff() in these functions), so
-- these refuse every non-member except Kabsi staff. sec1_tenant_matrix.sql sets kabsi_staff for its staff personas.
\if :{?kabsi_staff}
\else
select throws_ok($$ select public.activate_card('VCTM22', '00000000-0000-4000-8000-0000000000c1', 'x') $$, '42501', null, 'activate_card refuses a non-member');
