{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "installCommand": "npm install --registry=https://registry.npmjs.org --legacy-peer-deps --no-audit --no-fund",
  "buildCommand": "node scripts/check-env.mjs && npm run build",
  "redirects": [
    {
      "source": "/r/:code(SEVEN1|seven1)",
      "destination": "https://search.google.com/local/writereview?placeid=ChIJJ8-7quchHxURgn5sxhONNLI",
      "statusCode": 302
    },
    {
      "source": "/r/:path*",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/r-not-found",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lebanon",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/lebanon/:path*",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/product/:path*",
      "destination": "/pricing",
      "statusCode": 301
    },
    {
      "source": "/partner",
      "destination": "/partners",
      "statusCode": 301
    },
    {
      "source": "/partner/:path*",
      "destination": "/partners",
      "statusCode": 301
    },
    {
      "source": "/contact/:path*",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/report/:path*",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/auth/:path*",
      "destination": "/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js-de.sentry-cdn.com https://browser.sentry-cdn.com https://challenges.cloudflare.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ynjdqjlmdwjgbfezevxy.supabase.co https://*.googleusercontent.com https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://ynjdqjlmdwjgbfezevxy.supabase.co wss://ynjdqjlmdwjgbfezevxy.supabase.co https://*.ingest.de.sentry.io https://challenges.cloudflare.com https://connect.facebook.net https://www.facebook.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri https://o4512003528720384.ingest.de.sentry.io/api/4512145411801168/security/?sentry_key=b09a18a8ac370accf6b8e423fff77a8d"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/partner/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/staff/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/start/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/a/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/activate/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/staff",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/start/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/start",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/a/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/activate/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
