{
  "ci": {
    "collect": {
      "url": [
        "https://localhost:4174/",
        "https://localhost:4174/pricing",
        "https://localhost:4174/google-review-link",
        "https://localhost:4174/google-profile-check",
        "https://localhost:4174/how-it-works",
        "https://localhost:4174/faq",
        "https://localhost:4174/about",
        "https://localhost:4174/security",
        "https://localhost:4174/partners",
        "https://localhost:4174/guides",
        "https://localhost:4174/for",
        "https://localhost:4174/privacy",
        "https://localhost:4174/terms",
        "https://localhost:4174/scan",
        "https://localhost:4174/founding",
        "https://localhost:4174/for/hair-salon",
        "https://localhost:4174/for/florist"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --headless=new --ignore-certificate-errors"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https://localhost:4174/(pricing|google-review-link|google-profile-check|scan)?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^https://localhost:4174/(how-it-works|faq|about|security|partners|guides|for|privacy|terms|founding|for/hair-salon|for/florist)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 150, "aggregationMethod": "median" }],
            "resource-summary:script:size": ["warn", { "maxNumericValue": 122880 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report"
    }
  }
}
