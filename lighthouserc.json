{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/pricing",
        "http://localhost:4173/google-review-link",
        "http://localhost:4173/google-profile-check",
        "http://localhost:4173/how-it-works",
        "http://localhost:4173/faq",
        "http://localhost:4173/about",
        "http://localhost:4173/security",
        "http://localhost:4173/partners",
        "http://localhost:4173/guides",
        "http://localhost:4173/for",
        "http://localhost:4173/privacy",
        "http://localhost:4173/terms"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:4173/(pricing|google-review-link|google-profile-check)?$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/(how-it-works|faq|about|security|partners|guides|for|privacy|terms)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 150, "aggregationMethod": "median" }],
            "resource-summary:script:size": ["warn", { "maxNumericValue": 122880 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report"
    }
  }
}
